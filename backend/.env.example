# Copy to .env (local) or set these in your hosting platform's secrets panel. NEVER commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
FRONTEND_ORIGINS=https://your-frontend.netlify.app,http://localhost:5500
SERVE_FRONTEND=true
ENABLE_CLIP=true
ENABLE_BERT=true
CLIP_MODEL=openai/clip-vit-base-patch32
BERT_MODEL=distilbert-base-uncased
MAX_IMAGES=8
TORCH_THREADS=2
